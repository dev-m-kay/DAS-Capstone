DATABASE_URL=postgresql://postgres.[your-project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres
JWT_SECRET=change-this-to-a-long-random-string

# Optional. Comma-separated list of allowed origins for CORS / Socket.IO.
# Leave unset to reflect the request origin (useful for local dev). In
# production set to your real domain(s), e.g.:
# CORS_ORIGIN=https://kcr.example.com
# CORS_ORIGIN=
